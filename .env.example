# ---------------------------------------------------------------
# DeAltura Coffee — variables de entorno
# Copia este archivo a .env.local y llena lo que necesites.
# Sin nada configurado, el sitio corre en modo local:
#   - clientes y pedidos en .data/db.json (solo en tu compu, NO en Vercel)
#   - pagos simulados si no hay llave de Stripe
# ---------------------------------------------------------------

# URL pública del sitio (links de regreso de Stripe)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Secreto para firmar la sesión en modo local. Genera uno con: openssl rand -base64 32
AUTH_SECRET=change-me-to-a-long-random-string

# --- Datos ---------------------------------------------------------
# "local" (archivo JSON) o "supabase" (Postgres + Auth). En Vercel: supabase.
DATA_BACKEND=local
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Correos con acceso a /admin, separados por coma. En modo local, admin@dealtura.ca por defecto.
ADMIN_EMAILS=

# --- Pagos ---------------------------------------------------------
# Sin STRIPE_SECRET_KEY los pagos con tarjeta se simulan.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
